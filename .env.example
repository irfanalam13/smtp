POSTGRES_PASSWORD=replace-with-a-local-development-secret
POSTGRES_HOST_PORT=5434
DATABASE_URL=postgres://smtp_dev:replace-with-a-local-development-secret@localhost:5434/smtp_platform?sslmode=disable
API_DATABASE_MAX_CONNECTIONS=10
API_ADDR=127.0.0.1:8080
MAILBOX_SERVICE_ADDR=127.0.0.1:8081
MAILBOX_SERVICE_URL=http://127.0.0.1:8081
MAILBOX_SERVICE_HMAC_KEY=replace-with-64-hexadecimal-characters
IMAP_ADDR=127.0.0.1:993
IMAP_MAX_CONNECTIONS=256
IMAP_SERVER_NAME=smtp-platform
# Required to enable the implicit-TLS IMAP listener.
IMAP_TLS_CERT=
IMAP_TLS_KEY=
APP_ENVIRONMENT=development
CONTROL_PLANE_DEV_MODE=false
APP_PUBLIC_ORIGIN=http://127.0.0.1:3210
AUTH_SESSION_IDLE_TTL=30m
AUTH_SESSION_ABSOLUTE_TTL=12h
# Optional password-account email delivery; port 465 uses implicit TLS and
# other ports require STARTTLS. SMTP credentials must be set as a pair.
AUTH_SMTP_ADDR=
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_EMAIL_FROM=
# Server-side Next.js rewrite origin; set the deployed API origin outside local development.
API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_BRAND_NAME="SMTP Platform"
# Optional OIDC API resource-server configuration; set issuer and audience together.
OIDC_ISSUER_URL=
OIDC_API_AUDIENCE=
# Optional OIDC browser-login configuration; keep the secret server-side.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to APP_PUBLIC_ORIGIN/api/backend/v1/auth/oidc/callback.
OIDC_REDIRECT_URI=
# Outbound delivery is off until explicitly enabled. These local-only defaults
# target Mailpit; unauthenticated plaintext delivery is restricted to this
# exact loopback endpoint in the development environment.
SMTP_DELIVERY_ENABLED=false
SMTP_RELAY_HOST=127.0.0.1
SMTP_RELAY_PORT=1025
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
SMTP_RELAY_FROM=smtp-test@example.test
# Used only for direct-to-recipient delivery without an SMTP relay.
# Production direct-MX: leave every SMTP_RELAY_* value empty, set a controlled
# exact allowlist, and mount per-domain private keys below this secret path.
SMTP_DELIVERY_ALLOWLIST=
SMTP_DKIM_KEY_DIR=
# Domain checks use the system resolver with bounded timeouts.
# This development-only adapter must remain disabled in production.
# Optional DMARC report worker settings. The sender domain must have an active
# secret-manager DKIM key and an aligned SPF/DKIM policy before enabling worker.
SMTP_DKIM_REPORT_DOMAIN=
SMTP_DKIM_REPORT_SENDER=
SMTP_DKIM_REPORT_ORG_NAME=
SMTP_DKIM_REPORT_CONTACT=
