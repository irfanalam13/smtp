POSTGRES_PASSWORD=replace-with-a-local-development-secret
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://smtp_dev:replace-with-a-local-development-secret@localhost:5432/smtp_platform?sslmode=disable
API_DATABASE_MAX_CONNECTIONS=10
API_ADDR=127.0.0.1:8080
APP_ENVIRONMENT=development
CONTROL_PLANE_DEV_MODE=false
NEXT_PUBLIC_BRAND_NAME="SMTP Platform"
# Optional Keycloak OIDC resource-server configuration; set both or neither.
OIDC_ISSUER_URL=
OIDC_API_AUDIENCE=
